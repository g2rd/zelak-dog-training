# Sekrety Edge Functions do pracy LOKALNEJ.
#
# Skopiuj do `supabase/.env` (ten plik jest w .gitignore) i wpisz klucze
# TESTOWE. Nigdy nie wpisuj tu kluczy produkcyjnych i nigdy nie commituj
# pliku `.env`.
#
# Uruchomienie z tymi sekretami:
#   npx supabase functions serve --env-file supabase/.env
#
# Na produkcji te same wartości ustawia się poleceniem:
#   npx supabase secrets set NAZWA=wartosc

# Adres frontendu. Lokalnie port Vite, na produkcji https://zelak.pl
SITE_URL=http://localhost:5173

# Bunny → Stream Library → Security
BUNNY_LIBRARY_ID=123456
BUNNY_TOKEN_KEY=...
