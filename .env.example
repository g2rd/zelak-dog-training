# Skopiuj do `.env.local` (plik jest w .gitignore) i wpisz wartości z panelu
# Supabase → Project Settings → API. To są klucze PUBLICZNE — trafiają do
# przeglądarki. Klucza service_role NIGDY tu nie wpisuj.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Opcjonalnie: Client ID z Google Cloud → Google Auth Platform → Clients
# (kończy się na .apps.googleusercontent.com). Też publiczny. Z nim okienko
# logowania Google pokazuje zelak.pl i działa One Tap; bez niego przycisk
# Google przekierowuje przez serwer Supabase.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
